# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PORT: only used when running standalone (Docker/VPS) — ignored on Vercel.
PORT=3000

# COOKIE_SECURE: defaults to "true" when NODE_ENV=production, "false"
# otherwise. Override explicitly when serving over plain HTTP in production
# (e.g. a VPS with no domain/TLS configured yet) — a secure cookie is never
# sent by the browser over HTTP, which silently breaks login. Set back to
# "true" (or unset) once HTTPS is in place.
COOKIE_SECURE=""

TIMEOUT_MS=15000
MAX_CODES=200
CONCURRENCY=1

# Simulation Mode: Set to "true" to return mock data instead of doing real lookups
SIMULATION_MODE=false

# TRACKING_PROVIDER: "crnn" (default — captcha solving delegated over HTTP to
# the vendored correios-rastreamento service, see services/correios-rastreamento/)
# or "scraper" (own scraper of the public Correios tracking site with local
# OCR/paid captcha solving, no external service dependency — see README for
# the ToS/reliability caveats that apply to both).
TRACKING_PROVIDER=crnn

# Only used when TRACKING_PROVIDER=scraper.
# CAPTCHA_SOLVER: "ocr" (free, best-effort, default) or "2captcha"/"anticaptcha"
# (paid third-party solving service, more reliable).
CAPTCHA_SOLVER=ocr
# Required only when CAPTCHA_SOLVER is "2captcha" or "anticaptcha".
CAPTCHA_API_KEY=""
# How many times to retry with a fresh captcha before giving up on one check.
SCRAPER_MAX_CAPTCHA_RETRIES=3
# Minimum delay (ms) between requests to the Correios tracking site.
SCRAPER_REQUEST_DELAY_MS=1500

# Only used when TRACKING_PROVIDER=crnn (the default). Base URL of a running
# correios-rastreamento instance — see services/correios-rastreamento/ (vendored
# copy of https://github.com/opastorello/correios-rastreamento).
# - Local dev (npm run dev): `cd services/correios-rastreamento && docker
#   compose up` (serves on localhost:8003), then RASTREAMENTO_SERVICE_URL=http://localhost:8003
# - Full stack via the root docker-compose.yml (see README "Deploy em VPS com
#   Coolify"): the app talks to it over the internal Docker network, so this
#   var is already set to http://correios-rastreamento:8000 there — you don't
#   need to set it by hand in that case.
RASTREAMENTO_SERVICE_URL=http://localhost:8003
# Bearer token, only if that instance has API_TOKEN configured.
RASTREAMENTO_SERVICE_TOKEN=""

# Postgres connection string, used by the login/panel, API keys and the
# tracking-subscriptions/webhook feature (and its migration script,
# `npm run db:migrate`). Works with a plain local Postgres (e.g. via Docker —
# `docker run -e POSTGRES_PASSWORD=postgres -p 5433:5432 postgres:16-alpine`)
# as well as Neon or Vercel Postgres in production — the `pg`/node-postgres
# driver speaks standard Postgres wire protocol either way.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/api_correios"

# After DATABASE_URL is set and migrated, create your first panel user with:
#   npm run auth:create-user -- email@empresa.com senha
#
# DEV_AUTH_EMAIL / DEV_AUTH_PASSWORD: only for when you want to open the
# panel with NO database configured at all. When BOTH are set (and NODE_ENV
# is not "production"), login accepts exactly this email/password and keeps
# the session in memory instead of touching the database — but every OTHER
# DB-backed route (API keys, webhooks) still requires DATABASE_URL and will
# fail. If DATABASE_URL is set, prefer `npm run auth:create-user` above
# instead of these. Never set these in production; the check is
# hard-disabled whenever NODE_ENV=production.
DEV_AUTH_EMAIL=""
DEV_AUTH_PASSWORD=""

# Shared secret for /api/cron/run — required as "Authorization: Bearer
# $CRON_SECRET" on every call. On Vercel, Vercel's own Cron Jobs send this
# automatically once set as an env var. On the docker-compose stack (see
# README "Deploy em VPS com Coolify"), the `cron` sidecar service sends it on
# a timer instead (no Vercel Cron outside of Vercel).
CRON_SECRET="MY_CRON_SECRET"

# --- Only consumed by the root docker-compose.yml (VPS/Coolify deploy),
# not by the Node process directly ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD="MY_POSTGRES_PASSWORD"
POSTGRES_DB=api_correios
# Host port the app is published on (Coolify/reverse proxy target).
APP_PORT=3000
# How often (seconds) the `cron` sidecar calls /api/cron/run. 900 (15 min)
# gives enough granularity for the 1-12h monitoring profiles without
# depending on an external scheduler.
CRON_INTERVAL_SECONDS=900
# Bearer token for the vendored correios-rastreamento service. Only needed
# if you choose to publish its port publicly — in the default compose setup
# it's reachable only over the internal Docker network, not exposed.
RASTREAMENTO_API_TOKEN=""
